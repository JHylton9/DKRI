{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/report", "destination": "/report.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/portal", "destination": "/login.html" },
    { "source": "/portal/dashboard", "destination": "/admin.html" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/portal/dashboard", "permanent": false },
    { "source": "/login", "destination": "/portal", "permanent": false }
  ]
}
